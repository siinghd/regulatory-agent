    {
      "type": "stat",
      "title": "Model calls",
      "description": "kind: jev (TypeSafe Jev) or llm (OpenRouter). Pending instrumentation: `model_calls_total` (deploy/observability/METRICS_CONTRACT.md). No data until the app exports it.",
      "datasource": {
        "type": "prometheus",
        "uid": "regagent-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "regagent-prometheus"
          },
          "expr": "sum by (kind) (increase(model_calls_total[$__range]))",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "noValue": "pending"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
