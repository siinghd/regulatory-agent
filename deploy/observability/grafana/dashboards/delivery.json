    {
      "type": "stat",
      "title": "Emails sent",
      "description": "Pending instrumentation: `outbound_messages_total` (deploy/observability/METRICS_CONTRACT.md). No data until the app exports it.",
      "datasource": {
        "type": "prometheus",
        "uid": "regagent-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "regagent-prometheus"
          },
          "expr": "sum(increase(outbound_messages_total{outcome=\"sent\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
