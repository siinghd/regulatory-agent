          "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(provider_fetch_seconds_bucket[1h])))",
          "legendFormat": "{{provider}} p50",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
