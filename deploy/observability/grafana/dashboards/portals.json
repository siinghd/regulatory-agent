{
  "uid": "regagent-portals",
  "title": "Regulatory Document Agent — Regulator portals",
  "description": "Per-regulator portal fetches: success, latency, visits against the daily budget, breakers.",
  "tags": [
    "regagent"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "liveNow": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "regagent"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**MVP monitoring for evaluation of the Regulatory Document Agent.** Aggregate metrics only — no personal data or request contents. Not a production SLA.",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      },
      "transparent": true,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Fetch success by provider",
      "description": "Pending instrumentation: `provider_fetch_seconds` (deploy/observability/METRICS_CONTRACT.md). No data until the app exports it.",
      "datasource": {
        "type": "prometheus",
        "uid": "regagent-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "regagent-prometheus"
          },
          "expr": "sum by (provider) (increase(provider_fetch_seconds_count{outcome=\"ok\"}[$__range])) / sum by (provider) (increase(provider_fetch_seconds_count[$__range]))",
          "legendFormat": "{{provider}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "#EAB839",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "noValue": "pending"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "bargauge",
      "title": "Portal visits today vs daily budget",
      "description": "Visits counted against each provider's daily budget (resets at midnight UTC).",
      "datasource": {
        "type": "prometheus",
        "uid": "regagent-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "regagent-prometheus"
          },
          "expr": "max by (budget) (budget_used{budget=~\"portal:.*\"} / budget_limit{budget=~\"portal:.*\"})",
          "legendFormat": "{{budget}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "state-timeline",
      "title": "Portal circuit breakers",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "regagent-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "regagent-prometheus"
          },
          "expr": "max by (dependency) (breaker_open{dependency!~\"drop|smtp|openrouter:.*\"})",
          "legendFormat": "{{dependency}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "OPEN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Fetch latency p50 / p95 by provider (trailing 1 h)",
      "description": "Pending instrumentation: `provider_fetch_seconds` (deploy/observability/METRICS_CONTRACT.md). No data until the app exports it.",
      "datasource": {
        "type": "prometheus",
        "uid": "regagent-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "regagent-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(provider_fetch_seconds_bucket[1h])))",
          "legendFormat": "{{provider}} p95",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
