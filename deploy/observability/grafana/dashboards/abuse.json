    {
      "type": "stat",
      "title": "Pre-auth rejections (1 h)",
      "description": "Inbound mail refused by the per-IP/per-domain pre-auth limits. Counted in the ingest process. Pending instrumentation: `ingest /metrics` (deploy/observability/METRICS_CONTRACT.md). No data until the app exports it.",
      "datasource": {
        "type": "prometheus",
        "uid": "regagent-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "regagent-prometheus"
