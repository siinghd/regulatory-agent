# Observability secrets and settings. Copy to deploy/observability/.env (mode 600, gitignored by
# `*.env`); `make metrics-up` does this for you and generates the Grafana admin password.
# Read by docker-compose.yml (env_file) into grafana, grafana-init and alertmanager.

# ---------------------------------------------------------------- Grafana
# Admin login is local only (http://127.0.0.1:3310/grafana/ through an SSH tunnel); the public
# path is anonymous read-only and refuses /login. Used at first start only (stored hashed in the
# grafana volume); to change it later:
#   docker compose exec grafana grafana cli admin reset-admin-password '<new>'
GF_SECURITY_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Alertmanager
# blackhole (default: nothing leaves the host) | email | webhook
ALERT_RECEIVER=blackhole

# email: a path separate from the agent's own mailbox and SMTP account. Either the host's Postfix
# submission with a dedicated sender (create the alerts@hsingh.app mailbox first):
#   ALERT_SMTP_SMARTHOST=mail.hsingh.app:587  ALERT_SMTP_USERNAME=alerts@hsingh.app
# or an external SMTP relay (survives a broken host mail stack). No single quotes in values.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@hsingh.app
ALERT_SMTP_SMARTHOST=mail.hsingh.app:587
ALERT_SMTP_USERNAME=alerts@hsingh.app
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=true

# webhook: e.g. an ntfy topic URL (https://ntfy.sh/<long random topic>) for phone push.
ALERT_WEBHOOK_URL=

# Dead man's switch: blackhole | watchdog. With watchdog, RegagentWatchdog (always firing) is
# sent to ALERT_WATCHDOG_URL every 5 minutes; the external service alerts when it stops.
ALERT_WATCHDOG_RECEIVER=blackhole
ALERT_WATCHDOG_URL=

# Postgres/Redis exporter logins are NOT here: they go in deploy/observability/exporters.env,
# read only by those two containers (README.md, "After the cutover").
