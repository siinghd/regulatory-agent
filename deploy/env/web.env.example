# deploy/env/web.env — GENERATED by deploy/split-env.sh from .env (see services.toml).
# Read-only viewer: its own read-only role (agent_web); no mail, LLM or drop secrets. Redis for
# the per-client-IP rate limiter and /health/deep (if it is unreachable, pages are served unlimited).
DATABASE_URL=postgresql://agent_web:<generated>@127.0.0.1:5442/agent
REDIS_URL=redis://agent:<generated>@127.0.0.1:6392/0
PUBLIC_BASE_URL=https://uarb.example.org
