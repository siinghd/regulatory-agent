# Copy to .env (chmod 600). Never commit the real file.

# --- mailbox the agent answers (IMAP in, SMTP submission out)
AGENT_MAIL_ADDRESS=agent@example.org
AGENT_MAIL_PASSWORD=change-me
IMAP_HOST=mail.example.org
SMTP_HOST=mail.example.org
# hostname our MTA writes into Received headers; the only Received header trusted for SPF
TRUSTED_MTA_HOSTNAME=mail.example.org
# dmarc (default) | allowlist | off (tests only)
SENDER_AUTH_MODE=dmarc
# SENDER_ALLOWLIST=["@utility.example", "analyst@example.org"]

# --- storage / queue (docker compose publishes both on loopback)
# POSTGRES_PASSWORD is the bootstrap superuser's: break-glass only. Each process connects as its
# own least-privilege role (deploy/sql/roles.sql, created by deploy/db-cutover.sh).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://agent_app:change-me@127.0.0.1:5442/agent
MIGRATION_DATABASE_URL=postgresql://agent_migrator:change-me@127.0.0.1:5442/agent
WEB_DATABASE_URL=postgresql://agent_web:change-me@127.0.0.1:5442/agent
RETENTION_DATABASE_URL=postgresql://agent_retention:change-me@127.0.0.1:5442/agent
# Redis requires auth (deploy/redis/users.acl.template): the app's user is `agent`.
REDIS_PASSWORD=change-me
REDIS_ADMIN_PASSWORD=change-me
REDIS_URL=redis://agent:change-me@127.0.0.1:6392/0
DATA_DIR=./data

# --- keys (generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
# HMAC for pseudonymous ids in the audit log, retention and DSAR lookups. Never rotate casually:
# a new key makes every earlier HMAC unmatchable.
AUDIT_HMAC_KEY=
# Seals drop links, delete tokens and queued outbound mail at rest. Set it before the first
# start: changing it later makes queued mail and stored links unreadable.
DATA_ENCRYPTION_KEY=

# --- LLM via OpenRouter: summaries, and triage Jev is unsure of
OPENROUTER_API_KEY=sk-or-...
# In fallback order; each needs a zero-data-retention endpoint on OpenRouter.
# LLM_MODELS=["deepseek/deepseek-v4.1-flash","qwen/qwen3.8-27b"]

# --- TypeSafe Jev: request triage and citation checks (agent/typesafe.py)
# NOT zero-retention on our plan (LLM_ZERO_DATA_RETENTION covers OpenRouter only): email subject and
# body (gate) and public document excerpts (citation check) are sent to api.typesafe.ai. Disclosed
# in the privacy notice; set GATE_CLASSIFIER=llm and CITATION_CHECK=llm to send nothing there.
TYPESAFE_API_KEY=
# Pinned: the gate's and the citation check's thresholds were tuned on this version.
# TYPESAFE_MODEL=jev-1.13.0
# jev (default): rules, then Jev | llm: rules, then the OpenRouter classifier
# GATE_CLASSIFIER=jev
# When Jev is unsure or down: llm (default) asks the OpenRouter classifier | clarify asks the sender
# GATE_JEV_LOW_CONFIDENCE=llm
# Who checks that a quote supports its claim: jev (default; falls back to the LLM) | llm
# CITATION_CHECK=jev

# --- egress: UARB only answers North American IPs
UARB_PROXY=socks5://127.0.0.1:1080

# --- delivery and public links
DROP_BASE_URL=https://drop.example.org
DROP_UPLOAD_URL=http://127.0.0.1:3060
PUBLIC_BASE_URL=https://uarb.example.org

# --- abuse limits (defaults shown; README "Abuse protection" lists every layer)
# RATE_PER_SENDER_HOUR=6  RATE_PER_SENDER_DAY=20  RATE_PER_DOMAIN_HOUR=30  RATE_PER_DOMAIN_DAY=100
# RATE_GLOBAL_HOUR=300  RATE_GLOBAL_DAY=1000  RATE_NOTICES_PER_DAY=3  MAX_INFLIGHT_PER_SENDER=2
# PREAUTH_PER_IP_HOUR=30  PREAUTH_PER_DOMAIN_HOUR=60  INBOUND_PER_MINUTE=120
# LLM_DAILY_BUDGET_USD=2.0   (all model spend: OpenRouter, and TypeSafe at its list price)
# PORTAL_DAILY_VISITS={"uarb": 400, "oeb": 2000, "ferc": 2000}
# BYTES_PER_SENDER_DAY=1500000000
# WEB_RATE_PROGRESS_JSON_PER_MIN=60  WEB_RATE_PROGRESS_PER_MIN=30  WEB_RATE_FILES_PER_MIN=30
# WEB_RATE_FILES_PER_HOUR=200  WEB_RATE_CITATION_PER_MIN=60  WEB_RATE_DEFAULT_PER_MIN=120
